# OS-specific junk
.DS_Store
Thumbs.db

# Python artifacts
__pycache__/
*.py[cod]
*.pyo

# Virtual environments
.venv/
venv/

# Logs
logs/
*.log

# Local test files
test/
test*.py
**/test/

var/
vendor/

# Cert Directory
backend/app/security/configuration_files/vault/certs/

# JetBrains IDE
.idea/

# --- TLS private keys (never commit) ---
*.key
*.key.pem
*.p12
*.pfx

# --- Certificates (optional: ignore if you generate locally) ---
*.crt
*.cer
*.pem
*.der

# --- Vault bootstrap artifacts (never commit) ---
**/bootstrap/**
**/unseal_keys*.json
**/root_token*
**/seeded_secrets*.json

# --- CA serial files ---
*.srl

#Ignore local how to videos
how_to_videos/*

# containerlab qcow2/vmdk/etc (DO NOT COMMIT)
containerlab/images/

# (recommended) containerlab runtime artifacts (created on deploy)
containerlab/state/

# =========================
# Symfony frontend ignores
# =========================

# Local env (Vault injects runtime env; never commit local overrides)
 /frontend/.env.local
 /frontend/.env.*.local
 /frontend/.env.local.php

# Dependencies (Composer)
 /frontend/vendor/

# Runtime/cache/logs
 /frontend/var/

# PHPUnit / phpunit cache
 /frontend/.phpunit.result.cache
 /frontend/phpunit.xml
 /frontend/phpunit.xml.dist

# Symfony CLI local data (if you use symfony binary)
 /frontend/.symfony/

# If you use Node tooling (Encore / Vite / etc.)
 /frontend/node_modules/
 /frontend/public/build/
 /frontend/public/.vite/

# Common tooling noise
 /frontend/.DS_Store
 /frontend/npm-debug.log*
 /frontend/yarn-debug.log*
 /frontend/yarn-error.log*
 /frontend/pnpm-debug.log*