# OS-specific junk
.DS_Store
Thumbs.db

# Python artifacts
__pycache__/
*.py[cod]
*.pyo

# Virtual environments
.venv/
venv/

# Logs
logs/
*.log

# Local test files
test/
test*.py
**/test/

var/
vendor/

# Cert Directory
backend/app/security/configuration_files/vault/certs/

# JetBrains IDE
.idea/

# --- TLS private keys (never commit) ---
*.key
*.key.pem
*.p12
*.pfx

# --- Certificates (optional: ignore if you generate locally) ---
*.crt
*.cer
*.pem
*.der

# --- Vault bootstrap artifacts (never commit) ---
**/bootstrap/**
**/unseal_keys*.json
**/root_token*
**/seeded_secrets*.json

# --- CA serial files ---
*.srl

#Ignore local how to videos
how_to_videos/*

# containerlab qcow2/vmdk/etc (DO NOT COMMIT)
containerlab/images/

# (recommended) containerlab runtime artifacts (created on deploy)
containerlab/state/

# --- Frontend (Symfony) env files ---
/frontend/.env.local
/frontend/.env.*.local
/frontend/.env.local.php

# --- Frontend build/runtime directories ---
/frontend/vendor/
/frontend/var/
