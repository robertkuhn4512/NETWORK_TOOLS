# This file is used when you're turning up the symfony php container
# On a development machine. This will swap the container over to the dev side
# which includes debugging tools.
#
# If you do not run the compose command with this as a flag it will default to production mode

ENV_FILE=.env.dev

FRONTEND_PHP_FPM_TARGET=dev
SYMFONY_APP_ENV=dev
SYMFONY_APP_DEBUG=1

# In dev it can be handy to always warm cache (optional)
SYMFONY_CACHE_WARMUP=1
SYMFONY_CACHE_WARMUP_ALWAYS=1