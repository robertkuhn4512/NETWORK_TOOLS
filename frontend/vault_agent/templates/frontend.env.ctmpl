{{- $fqdn := env "PRIMARY_SERVER_FQDN" -}}
{{- if not $fqdn -}}{{- $fqdn = "networkengineertools.com" -}}{{- end -}}
{{- $httpsPort := env "PUBLIC_HTTPS_PORT" -}}
{{- if not $httpsPort -}}{{- $httpsPort = "8443" -}}{{- end -}}

{{- with secret "secret/data/network_tools/frontend" -}}
{{- $d := .Data.data -}}

APP_ENV={{ printf "%q" (or $d.APP_ENV "prod") }}
APP_DEBUG={{ printf "%q" (or $d.APP_DEBUG "0") }}
APP_SECRET={{ printf "%q" (or $d.APP_SECRET "") }}

# Keycloak
KEYCLOAK_AUTH_SERVER_URL={{ printf "%q" (printf "https://auth.%s:%s" $fqdn $httpsPort) }}
KEYCLOAK_REALM={{ printf "%q" (or $d.KEYCLOAK_REALM "network_tools") }}
KEYCLOAK_CLIENT_ID={{ printf "%q" (or $d.KEYCLOAK_CLIENT_ID "") }}
KEYCLOAK_CLIENT_SECRET={{ printf "%q" (or $d.KEYCLOAK_CLIENT_SECRET "") }}

# FastAPI (optional service-account creds)
FASTAPI_OIDC_CLIENT_ID={{ printf "%q" (or $d.FASTAPI_OIDC_CLIENT_ID "") }}
FASTAPI_OIDC_CLIENT_SECRET={{ printf "%q" (or $d.FASTAPI_OIDC_CLIENT_SECRET "") }}

{{- end -}}
