APP_ENV=prod
APP_DEBUG=0

# Symfony
APP_SECRET={{ with secret "app_network_tools_secrets/data/frontend_secrets" }}{{ .Data.data.APP_SECRET }}{{ end }}

# Keycloak public base (what browsers hit)
KEYCLOAK_BASE_URL=https://auth.{{ env "PRIMARY_SERVER_FQDN" }}:{{ env "PUBLIC_HTTPS_PORT" }}
KEYCLOAK_REALM={{ with secret "app_network_tools_secrets/data/frontend_secrets" }}{{ .Data.data.KEYCLOAK_REALM }}{{ end }}
KEYCLOAK_CLIENT_ID={{ with secret "app_network_tools_secrets/data/frontend_secrets" }}{{ .Data.data.KEYCLOAK_CLIENT_ID }}{{ end }}
KEYCLOAK_CLIENT_SECRET={{ with secret "app_network_tools_secrets/data/frontend_secrets" }}{{ .Data.data.KEYCLOAK_CLIENT_SECRET }}{{ end }}

# FastAPI public base (per your requirement)
FASTAPI_BASE_URL=https://api.{{ env "PRIMARY_SERVER_FQDN" }}:{{ env "PUBLIC_HTTPS_PORT" }}

# Optional: service-account creds used by Symfony to call API (client-credentials)
FASTAPI_OIDC_CLIENT_ID={{ with secret "app_network_tools_secrets/data/frontend_secrets" }}{{ .Data.data.FASTAPI_OIDC_CLIENT_ID }}{{ end }}
FASTAPI_OIDC_CLIENT_SECRET={{ with secret "app_network_tools_secrets/data/frontend_secrets" }}{{ .Data.data.FASTAPI_OIDC_CLIENT_SECRET }}{{ end }}
