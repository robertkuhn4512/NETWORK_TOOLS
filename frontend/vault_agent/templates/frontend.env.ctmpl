{{- /* -------------------- helpers -------------------- */ -}}
{{- $fqdn := env "PRIMARY_SERVER_FQDN" -}}
{{- if not $fqdn -}}{{- $fqdn = "networkengineertools.com" -}}{{- end -}}

{{- $httpsPort := env "PUBLIC_HTTPS_PORT" -}}
{{- if not $httpsPort -}}{{- $httpsPort = "8443" -}}{{- end -}}

{{- /* -------------------- secrets -------------------- */ -}}
{{- with secret "app_network_tools_secrets/data/frontend_secrets" -}}
{{- $d := .Data.data -}}

{{- /* APP_ENV */ -}}
{{- $appEnv := (or (index $d "APP_ENV") "prod") -}}
{{- printf "APP_ENV=%q\n" $appEnv -}}

{{- /* APP_DEBUG (normalize a bit) */ -}}
{{- $rawDbg := (index $d "APP_DEBUG") -}}
{{- $dbg := "" -}}
{{- if $rawDbg -}}{{- $dbg = trim " \t\r\n" (printf "%v" $rawDbg) -}}{{- end -}}
{{- if or (eq $dbg "1") (eq $dbg "true") (eq $dbg "TRUE") -}}
{{- printf "APP_DEBUG=%q\n" "1" -}}
{{- else if or (eq $dbg "0") (eq $dbg "false") (eq $dbg "FALSE") -}}
{{- printf "APP_DEBUG=%q\n" "0" -}}
{{- else -}}
{{- printf "APP_DEBUG=%q\n" (or $dbg "0") -}}
{{- end -}}

{{- /* APP_SECRET */ -}}
{{- printf "APP_SECRET=%q\n" (or (index $d "APP_SECRET") "") -}}

{{- printf "\n" -}}

{{- /* Keycloak (match what Symfony expects) */ -}}
{{- printf "KEYCLOAK_AUTH_SERVER_URL=%q\n" (printf "https://auth.%s:%s" $fqdn $httpsPort) -}}
{{- printf "KEYCLOAK_REALM=%q\n" (or (index $d "KEYCLOAK_REALM") "network_tools") -}}
{{- printf "KEYCLOAK_CLIENT_ID=%q\n" (or (index $d "KEYCLOAK_CLIENT_ID") "") -}}
{{- printf "KEYCLOAK_CLIENT_SECRET=%q\n" (or (index $d "KEYCLOAK_CLIENT_SECRET") "") -}}
{{- printf "APP_LOGOUT_REDIRECT_URL=%q\n" (or (index $d "APP_LOGOUT_REDIRECT_URL") "") -}}

{{- printf "\n" -}}

{{- /* FastAPI (optional service-account creds) */ -}}
{{- printf "FASTAPI_BASE_URL=%q\n" (printf "https://api.%s:%s" $fqdn $httpsPort) -}}
{{- printf "FASTAPI_OIDC_CLIENT_ID=%q\n" (or (index $d "FASTAPI_OIDC_CLIENT_ID") "") -}}
{{- printf "FASTAPI_OIDC_CLIENT_SECRET=%q\n" (or (index $d "FASTAPI_OIDC_CLIENT_SECRET") "") -}}

{{- else -}}
{{- /* If Vault read fails, still emit a valid env file */ -}}
{{- printf "APP_ENV=%q\n" "prod" -}}
{{- printf "APP_DEBUG=%q\n" "0" -}}
{{- printf "APP_SECRET=%q\n" "" -}}
{{- printf "KEYCLOAK_AUTH_SERVER_URL=%q\n" (printf "https://auth.%s:%s" $fqdn $httpsPort) -}}
{{- printf "KEYCLOAK_REALM=%q\n" "network_tools" -}}
{{- printf "KEYCLOAK_CLIENT_ID=%q\n" "" -}}
{{- printf "KEYCLOAK_CLIENT_SECRET=%q\n" "" -}}
{{- printf "APP_LOGOUT_REDIRECT_URL=%q\n" "" -}}
{{- printf "FASTAPI_BASE_URL=%q\n" (printf "https://api.%s:%s" $fqdn $httpsPort) -}}
{{- printf "FASTAPI_OIDC_CLIENT_ID=%q\n" "" -}}
{{- printf "FASTAPI_OIDC_CLIENT_SECRET=%q\n" "" -}}
{{- end -}}
