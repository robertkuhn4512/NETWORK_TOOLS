{{- printf "KEYCLOAK_REALM=%q\n" (printf "%v" (or (index $d "KEYCLOAK_REALM") "")) -}}

{{- printf "\n" -}}

{{- /* FastAPI (frontend -> FastAPI integration / OIDC) */ -}}
